# Claude API. Without it the app runs on the built-in ranking with standard explanations.
ANTHROPIC_API_KEY=

# Signs the session token that holds the per-session limits. Use a long random string.
SESSION_SECRET=change-me

# Postgres (Supabase). Without it the app uses data/names.sample.json and in-memory counters.
DATABASE_URL=

# Default daily LLM budget in USD. The app_settings table overrides it without a deploy.
DAILY_BUDGET_USD=3

# Daily feedback email and owner alerts (Resend).
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAILS=

# Protects the scheduled feedback digest endpoint.
CRON_SECRET=

# Cloudflare Turnstile bot check on new sessions. Without both, sessions open with no check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
